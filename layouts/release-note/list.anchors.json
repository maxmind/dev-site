{{- /*
  One entry for each note with a legacy_anchor, so an anchor that several
  notes share gets one entry per note. The order is newest first, because
  release-note-anchors.ts takes the first match. The server never sees a URL
  fragment, so the script resolves an old year-page fragment in the browser.
*/ -}}
{{- $entries := slice }}
{{- range .Pages.ByDate.Reverse }}
  {{- $note := . }}
  {{- with .Params.legacy_anchor }}
    {{- $entries = $entries | append (dict
        "anchor" .
        "year" ($note.Date.Format "2006")
        "date" ($note.Date.Format "2006-01-02")
        "url" $note.RelPermalink
      )
    }}
  {{- end }}
{{- end }}
{{- $entries | jsonify }}
