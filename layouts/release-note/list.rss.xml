{{- /*
  Section-level RSS template for release notes.

  A note with a legacy_anchor predates the split into one page per note. Its
  item keeps the guid and 16:00Z pubDate the year-page feed gave it. HubSpot
  does not mail an item again while both stay the same. Its link goes to the
  note's own page, and its body can differ. Newer notes use their own URL and
  date.
*/ -}}

{{- $items := slice }}
{{- $section := .Permalink }}

{{- range .Pages.ByDate.Reverse }}
  {{- $guid := .Permalink }}
  {{- $published := .Date }}
  {{- with .Params.legacy_anchor }}
    {{- $guid = printf "%s%s/#%s" $section ($published.Format "2006") . }}
    {{- $published = time.AsTime (printf "%sT16:00:00Z" ($published.Format "2006-01-02")) }}
  {{- end }}
  {{- $items = $items | append (dict
      "title" .Title
      "link" .Permalink
      "guid" $guid
      "date" $published
      "content" .Content
    )
  }}
{{- end }}

{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
  {{- $items = $items | first $limit }}
{{- end }}

{{- $rssURL := printf "%sindex.xml" $section }}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Title }}</description>
    <generator>Hugo</generator>
    <lastBuildDate>{{ now | time.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{ printf "<atom:link href=%q rel=\"self\" />" $rssURL | safeHTML }}
    {{- range $items }}
    <item>
      <title>{{ .title | transform.XMLEscape | safeHTML }}</title>
      <link>{{ .link }}</link>
      <pubDate>{{ .date | time.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .guid }}</guid>
      <content:encoded>{{ .content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
