{{- /*
  Section-level RSS template for release notes.

  Both branches below produce the same thing: a list of items carrying title,
  link, guid, pubDate and content. Only the source differs. minFraud reads
  individual note pages; GeoIP still scrapes its year pages and loses that
  branch when it migrates.
*/ -}}

{{- $items := slice }}
{{- $section := .Permalink }}

{{- if .Params.individual_notes }}
  {{- /*
    A note carrying a legacy anchor was published before the notes were split
    into individual pages. Its guid and pubDate stay as the year-page feed
    rendered them: the year URL with the anchor, and the 16:00Z stamp that feed
    applied to every note regardless of front matter hour. That hour is not a
    publication time. It orders notes that share a date. HubSpot does not mail
    an item again while its guid and pubDate are unchanged, so subscribers are
    not mailed announcements they have already read. The link goes to the
    note's own page. Notes written after the split have no anchor and use their
    own URL and timestamp.
  */ -}}
  {{- range .Pages.ByDate.Reverse }}
    {{- $guid := .Permalink }}
    {{- $published := .Date }}
    {{- with .Params.legacy_anchor }}
      {{- $guid = printf "%s%s/#%s" $section ($published.Format "2006") . }}
      {{- $published = time.AsTime (printf "%sT16:00:00Z" ($published.Format "2006-01-02")) }}
    {{- end }}
    {{- $items = $items | append (dict
        "title" .Title
        "link" .Permalink
        "guid" $guid
        "date" $published
        "content" .Content
      )
    }}
  {{- end }}
{{- else }}
  {{- range .Pages.ByDate.Reverse }}
    {{- $page := . }}
    {{- range (findRE `(?s)<div class="release-note".+?(?:<!-- end-release-note -->|$)` .Content) }}
      {{- $anchor := replaceRE `(?s).+data-anchor="(.+?)".+` "$1" . }}
      {{- $title := replaceRE `(?s).+data-title="(.+?)".+` "$1" . }}
      {{- $date := replaceRE `(?s).+data-date="(.+?)".+` "$1" . }}
      {{- $content := replaceRE `(?s).+<div class="release-note__content">(.+?)(?:<!-- end-content -->|$).+` "$1" . }}
      {{- $items = $items | append (dict
          "title" $title
          "link" (printf "%s#%s" $page.Permalink $anchor)
          "guid" (printf "%s#%s" $page.Permalink $anchor)
          "date" (time.AsTime (printf "%sT16:00:00Z" $date))
          "content" (trim $content "\n ")
        )
      }}
    {{- end }}
  {{- end }}
  {{- $items = sort $items "date" "desc" }}
{{- end }}

{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
  {{- $items = $items | first $limit }}
{{- end }}

{{- $rssURL := printf "%sindex.xml" $section }}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Title }}</description>
    <generator>Hugo</generator>
    <lastBuildDate>{{ now | time.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{ printf "<atom:link href=%q rel=\"self\" />" $rssURL | safeHTML }}
    {{- range $items }}
    <item>
      <title>{{ .title | transform.XMLEscape | safeHTML }}</title>
      <link>{{ .link }}</link>
      <pubDate>{{ .date | time.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .guid }}</guid>
      <content:encoded>{{ .content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
